# The image needs backend/ and frontend/ only; everything else stays out of the build context.
.git
.gitignore
.venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/node_modules
frontend/dist
frontend/e2e
backend/tests
var
**/*.db
**/*.db-wal
**/*.db-shm
.env
.env.*
!.env.example
data
docs
presentation
private
Dockerfile
docker-compose.yml
Makefile
*.md
!backend/README.md
