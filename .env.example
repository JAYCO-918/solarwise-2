# SolarWise DZ - settings.
#
# Copy this file to ".env" and edit it. ".env" is read
#   - by the application, from the directory it is started in (for example by "make run"), and
#   - by "docker compose".
# A variable set in the environment wins over this file. Lines that are commented out show the default.
# Never commit ".env".

# ----------------------------------------------------------------------------- required with Docker Compose
# Key that signs the access tokens. At least 32 characters; mandatory when SOLARWISE_ENVIRONMENT=production.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty outside production, a random key is used and every session ends when the server stops.
SOLARWISE_SECRET_KEY=

# Password of the PostgreSQL account created by docker-compose.yml. It becomes part of a URL: use letters,
# digits, "-" and "_" only.  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Port published by Docker Compose.
#SOLARWISE_PORT=8000

# ----------------------------------------------------------------------------- what the server shows
# true: the synthetic El Foulia reference case with its ten scenarios is created, and "Open the demonstration"
# lets anyone in without an account. Every result of the demonstration is marked simulated.
SOLARWISE_DEMO_MODE=true

# true (the default): "Create an account" on the sign-in page lets whoever reaches the server create an account for
# themselves. It gets the engineer role - never administrator - and sees no plant of anybody else. The e-mail
# address is not verified. false: accounts are created by an administrator or with "solarwise create-user" only.
#SOLARWISE_ALLOW_REGISTRATION=true

# First administrator, created at start-up while the installation has no administrator (ignored afterwards).
# The password needs at least 12 characters. An administrator can also be created with "solarwise create-user".
#SOLARWISE_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
#SOLARWISE_BOOTSTRAP_ADMIN_PASSWORD=

# ----------------------------------------------------------------------------- database (not used by Docker Compose)
# SQLite file (default) or PostgreSQL. Docker Compose sets this itself.
#DATABASE_URL=sqlite:///./var/solarwise.db
#DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/solarwise

# ----------------------------------------------------------------------------- HTTP
# development | production. "production" refuses to start without a secret key and adds HSTS.
#SOLARWISE_ENVIRONMENT=development
# Host names the server answers to, separated by commas. "*" accepts any; name yours in production.
#SOLARWISE_ALLOWED_HOSTS=*
# Other origins allowed to call the API from a browser, separated by commas. Empty: same origin only.
#SOLARWISE_CORS_ORIGINS=
# Who may show the application inside a frame: 'self', 'none', or a list of origins.
#SOLARWISE_FRAME_ANCESTORS='self'
# Largest accepted upload, in MB.
#SOLARWISE_MAX_UPLOAD_MB=25
# Lifetime of a session, in minutes.
#SOLARWISE_ACCESS_TOKEN_MINUTES=60
# Folder of the built web interface (default: frontend/dist of a source checkout).
#SOLARWISE_FRONTEND_DIST=

# ----------------------------------------------------------------------------- sign-in throttling
#SOLARWISE_LOGIN_MAX_ATTEMPTS=5
#SOLARWISE_LOGIN_WINDOW_SECONDS=300
#SOLARWISE_LOGIN_LOCKOUT_SECONDS=900

# ----------------------------------------------------------------------------- external data (optional)
# PVGIS (typical-year baseline) and NASA POWER (weather context) are called only when a user asks for them.
#SOLARWISE_EXTERNAL_DATA_ENABLED=true
#SOLARWISE_EXTERNAL_TIMEOUT_SECONDS=20

# ----------------------------------------------------------------------------- language model (optional, off)
# Only rephrases the explanation written by the engine; it never decides and never adds a figure.
# none | openai | anthropic. A provider needs SOLARWISE_AI_API_KEY.
#SOLARWISE_AI_PROVIDER=none
#SOLARWISE_AI_API_KEY=
#SOLARWISE_AI_MODEL=
#SOLARWISE_AI_BASE_URL=
#SOLARWISE_AI_TIMEOUT_SECONDS=30
